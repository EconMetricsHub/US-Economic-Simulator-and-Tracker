name = "macroscope-ai"
main = "src/index.js"
compatibility_date = "2026-09-01"

[vars]
ALLOWED_ORIGIN = "https://econmetricshub.github.io"
LLM_API_BASE = "https://api.groq.com/openai/v1"
LLM_MODEL = "openai/gpt-oss-20b"

# Secrets are NOT stored in this file.
# Set them from the worker directory with:
#   npx.cmd wrangler secret put LLM_API_KEY --config wrangler.toml
#   npx.cmd wrangler secret put FRED_API_KEY --config wrangler.toml
