name = "macroscope-ai"
main = "src/index.js"
compatibility_date = "2026-09-01"

[vars]
# Use your exact GitHub Pages origin. You can comma-separate multiple allowed origins.
ALLOWED_ORIGIN = "https://econmetricshub.github.io"
LLM_API_BASE = "https://api.groq.com/openai/v1"
LLM_MODEL = "openai/gpt-oss-20b"
# Never put the API key here. Set it with: wrangler secret put LLM_API_KEY
